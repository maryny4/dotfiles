 src/capture/mod.rs | 100 ++++++++++++++++++++++-----------------------
 1 file changed, 49 insertions(+), 51 deletions(-)

diff --git a/src/capture/mod.rs b/src/capture/mod.rs
index 24669e2..bb20554 100644
--- a/src/capture/mod.rs
+++ b/src/capture/mod.rs
@@ -120,43 +120,19 @@ fn clamp_to_h264_software_limits(width: u32, height: u32) -> (u32, u32) {
     (scaled_width, scaled_height)
 }
 
-fn normalize_to_source_aspect_bounds(
