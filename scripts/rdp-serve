#!/bin/bash
# hypr-rdp needs the Hyprland session env; supply it so it also works over SSH
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -1)}"

# This box's AMD iGPU VA-API H.264 encoder produces blank frames and the NVIDIA
# card has no VA-API encode, so force hypr-rdp's software encoder by hiding VA-API.
export LIBVA_DRIVERS_PATH=/nonexistent
export HYPR_RDP_DISABLE_AVC444=1

exec hypr-rdp "$@"
