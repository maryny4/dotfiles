#!/usr/bin/env bash
# Sample machine state to disk so the last snapshot survives a hard freeze.
# Every write is fsynced: a frozen box never flushes its page cache, which is
# why the journal always cuts off mid-line with no clue about the cause.
set -uo pipefail

dir="${XDG_STATE_HOME:-$HOME/.local/state}/freeze-watch"
log="$dir/state.log"
interval="${FREEZE_WATCH_INTERVAL:-5}"
maxsize="${FREEZE_WATCH_MAXSIZE:-33554432}"

mkdir -p "$dir"

temps() {
    local h name t out=""
    for h in /sys/class/hwmon/hwmon*; do
        [ -r "$h/name" ] || continue
        read -r name < "$h/name"
        case "$name" in
            k10temp|amdgpu|nvme|spd5118) ;;
            *) continue ;;
        esac
        [ -r "$h/temp1_input" ] || continue
        read -r t < "$h/temp1_input"
        out+="$name=$((t / 1000)) "
    done
    printf '%s' "$out"
}

gpu() {
    command -v nvidia-smi >/dev/null || return 0
    timeout 3 nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,memory.used \
        --format=csv,noheader,nounits 2>/dev/null |
        awk -F', *' 'NR==1{printf "nv_temp=%s nv_util=%s nv_mem=%sM ", $1, $2, $3}'
}

printf '=== start %s boot=%s kernel=%s\n' \
    "$(date -Is)" "$(cat /proc/sys/kernel/random/boot_id)" "$(uname -r)" >> "$log"

while :; do
    if [ -f "$log" ] && [ "$(stat -c %s "$log" 2>/dev/null || echo 0)" -gt "$maxsize" ]; then
        mv -f "$log" "$log.1"
    fi

    {
        printf '%s ' "$(date -Is)"
        read -r l1 l5 l15 _ < /proc/loadavg
        printf 'load=%s/%s/%s ' "$l1" "$l5" "$l15"
        awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2}
             END{printf "mem_used=%dM mem_avail=%dM swap_used=%dM ", (t-a)/1024, a/1024, (st-sf)/1024}' \
            /proc/meminfo
        temps
        gpu
        ps -eo pcpu=,pmem=,comm= --sort=-pcpu 2>/dev/null | head -3 |
            awk '{printf "top%d=%s:%s%%cpu:%s%%mem ", NR, $3, $1, $2}'
        printf '\n'
    } >> "$log" 2>/dev/null

    sync -d "$log" 2>/dev/null || sync
    sleep "$interval"
done
